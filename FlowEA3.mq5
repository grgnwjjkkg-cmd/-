int g_doneKey[14];
//================== 守り（ドローダウンでロット半分）=====================
double g_peak=0; bool g_thr=false; int g_lvl=0; string g_gvPeak="", g_gvThr="";
double RiskMult()
{
   if(!InpUseDDThrottle) return 1.0;
   double b=AccountInfoDouble(ACCOUNT_BALANCE);
   if(g_peak<=0) g_peak=b;
   if(b>g_peak) g_peak=b;
   double dd=(g_peak>0)?(1.0-b/g_peak)*100.0:0;
   int lv=0; if(dd>=InpDD1Pct) lv=1; if(dd>=InpDD2Pct) lv=2; if(dd>=InpDD3Pct) lv=3;
   double mul=(lv==0?1.0:lv==1?InpDD1Mul:lv==2?InpDD2Mul:InpDD3Mul);
   if(lv!=g_lvl && InpVerbose) Print("守り：最高値から",DoubleToString(dd,1),"%減 → ロット×",DoubleToString(mul,2),"（段階",lv,"）");
   g_lvl=lv; g_thr=(lv>0);
   if(!MQLInfoInteger(MQL_TESTER)){ GlobalVariableSet(g_gvPeak,g_peak); GlobalVariableSet(g_gvThr,lv); }
   return mul;
}
double RiskPct(){ return InpRiskPct*RiskMult(); }
void ThrottleInit()
{
   g_gvPeak="FlowEA3_peak_"+IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
   g_gvThr ="FlowEA3_thr_" +IntegerToString(AccountInfoInteger(ACCOUNT_LOGIN));
   g_peak=0; g_thr=false;
   if(!MQLInfoInteger(MQL_TESTER))   // 再起動しても最高値を覚えておく
   {
      if(GlobalVariableCheck(g_gvPeak)) g_peak=GlobalVariableGet(g_gvPeak);
      if(GlobalVariableCheck(g_gvThr))  g_thr=(GlobalVariableGet(g_gvThr)>0.5);
   }
   RiskMult();
   if(InpVerbose) Print("守り：最高値 ",DoubleToString(g_peak,0),"  状態 ",g_thr?"発動中（ロットを減らしています）":"通常");
}
bool IsJPHolAfter(datetime jstDay)
{
   string d=TimeToString(jstDay,TIME_DATE);
   if(StringFind(JPHOL_DATES,d)>=0) return true;
   if(InpJPHolDates!="" && StringFind(InpJPHolDates,d)>=0) return true;
   return false;
}
// ストラドル管理
struct StrEv { datetime relUTC; int kind; int holdMin; bool placed; bool closed; };  // kind 1=CPI 2=NFP 3=RBNZ 4=カナダCPI 5=豪CPI
StrEv g_ev[];   // 同じ日に二重に入らないための記録（YYYYMMDD）

//================== 時刻（夏時間）=====================================
datetime MakeT(int y,int m,int d,int hh=0,int mi=0)
{
   MqlDateTime s; s.year=y; s.mon=m; s.day=d; s.hour=hh; s.min=mi; s.sec=0;
   return StructToTime(s);
}
int DowOf(datetime t){ MqlDateTime s; TimeToStruct(t,s); return s.day_of_week; }
// n番目の日曜（n=-1 は最後の日曜）
datetime NthSunday(int y,int m,int n)
{
   if(n>0){ datetime t=MakeT(y,m,1); while(DowOf(t)!=0) t+=86400; return t+(n-1)*7*86400; }
   datetime t=MakeT(y,m,1)+ (datetime)(31*86400); MqlDateTime s; TimeToStruct(t,s);
   t=MakeT(s.year,s.mon,1)-86400; while(DowOf(t)!=0) t-=86400; return t;
}
bool IsUSDST(datetime utc)
{
   MqlDateTime s; TimeToStruct(utc,s);
   datetime a=NthSunday(s.year,3,2)+7*3600, b=NthSunday(s.year,11,1)+6*3600;
   return utc>=a && utc<b;
}
bool IsUKDST(datetime utc)
{
   MqlDateTime s; TimeToStruct(utc,s);
   datetime a=NthSunday(s.year,3,-1)+3600, b=NthSunday(s.year,10,-1)+3600;
   return utc>=a && utc<b;
}
// XMのサーバー時間は GMT+2（冬）/ GMT+3（夏）。夏時間の切り替えは「ヨーロッパの夏時間」に合わせている
// （3月最終日曜〜10月最終日曜）。米国と欧州の切り替えがずれる年3週ほどを正しく扱うため、
// 本番では「サーバー時刻 − パソコンのUTC時刻」から実際の時差を測り、テスターでは欧州夏時間のルールを使う。
int ServerOffsetHours(datetime utcGuess)
{
   if(!MQLInfoInteger(MQL_TESTER))
   {
      long d=(long)(TimeTradeServer()-TimeGMT());
      int h=(int)MathRound(d/3600.0);
      if(h==2 || h==3) return h;
   }
   return IsUKDST(utcGuess)?3:2;
}
datetime ServerToUTC(datetime srv)
{
   datetime g=srv-2*3600;               // まず GMT+2 とみなす
   return srv-ServerOffsetHours(g)*3600;
}
datetime UTCToServer(datetime utc){ return utc + ServerOffsetHours(utc)*3600; }
datetime NowUTC(){ return ServerToUTC(TimeTradeServer()); }
datetime ToLondon(datetime utc){ return utc + (IsUKDST(utc)?3600:0); }
datetime ToNY(datetime utc){ return utc - (IsUSDST(utc)?4:5)*3600; }
datetime ToTokyo(datetime utc){ return utc + 9*3600; }
int DateKey(datetime t){ MqlDateTime s; TimeToStruct(t,s); return s.year*10000+s.mon*100+s.day; }

//================== カレンダー ======================================
int DaysInMonth(int y,int m){ datetime a=MakeT(y,m,1); datetime b=(m==12)?MakeT(y+1,1,1):MakeT(y,m+1,1); return (int)((b-a)/86400); }
bool IsGotoNum(datetime d)   // 5・10・15・20・25・30日、または月末日
{
   MqlDateTime s; TimeToStruct(d,s);
   return (s.day%5==0) || (s.day==DaysInMonth(s.year,s.mon));
}
bool IsGotobi(datetime jstDay)   // 土日にあたるゴトー日は前の金曜
{
   int w=DowOf(jstDay);
   if(w==0||w==6) return false;
   if(IsGotoNum(jstDay)) return true;
   if(w==5){ if(IsGotoNum(jstDay+86400)||IsGotoNum(jstDay+2*86400)) return true; }
   return false;
}
bool IsLastBizDay(datetime lonDay)   // その月の最後の平日（祝日は考慮しない）
{
   int w=DowOf(lonDay); if(w==0||w==6) return false;
   datetime n=lonDay+86400; while(DowOf(n)==0||DowOf(n)==6) n+=86400;
   MqlDateTime a,b; TimeToStruct(lonDay,a); TimeToStruct(n,b);
   return a.mon!=b.mon;
}
bool IsFOMCDay(datetime nyDay)
{
   MqlDateTime s; TimeToStruct(nyDay,s); string d=StringFormat("%04d-%02d-%02d",s.year,s.mon,s.day);
   return StringFind(InpFOMCDates,d)>=0 || StringFind(HIST_FOMC,d)>=0 || StringFind(H09_FOMC,d)>=0;
}

//================== 銘柄・ロット =====================================
string Resolve(string base)
{
   // 同じ名前で始まる銘柄（USDJPY / USDJPY# など）の中から「取引できる」かつ「スプレッドが一番狭い」ものを選ぶ
   string alt=base; if(base=="XAUUSD") alt="GOLD"; if(base=="XAGUSD") alt="SILVER";
   // まずKIWAMI極の「#」付きを直接試す（他の銘柄のデータを読み込まないので速く、容量も使わない）
   string c1=base+"#", c2=alt+"#";
   if(SymbolSelect(c1,true) && SymbolInfoInteger(c1,SYMBOL_TRADE_MODE)==SYMBOL_TRADE_MODE_FULL){ Print("銘柄 ",base," → ",c1); return c1; }
   if(SymbolSelect(c2,true) && SymbolInfoInteger(c2,SYMBOL_TRADE_MODE)==SYMBOL_TRADE_MODE_FULL){ Print("銘柄 ",base," → ",c2); return c2; }
   string best=""; double bestSp=1e18;
   for(int i=0;i<SymbolsTotal(false);i++)
   {
      string nm=SymbolName(i,false);
      if(StringFind(nm,base)!=0 && StringFind(nm,alt)!=0) continue;
      if(StringLen(nm)>StringLen(base)+2 && StringLen(nm)>StringLen(alt)+2) continue;   // 別の銘柄を避ける
      if(!SymbolSelect(nm,true)) continue;
      if(SymbolInfoInteger(nm,SYMBOL_TRADE_MODE)!=SYMBOL_TRADE_MODE_FULL) continue;
      double sp=(double)SymbolInfoInteger(nm,SYMBOL_SPREAD)*SymbolInfoDouble(nm,SYMBOL_POINT);
      if(best=="" || sp<bestSp){ best=nm; bestSp=sp; }
   }
   if(best!="") Print("銘柄 ",base," → ",best,"（取引可・スプレッド最小）");
   return best;
}
double DailyATR(string sym)
{
   int h=iATR(sym,PERIOD_D1,14); if(h==INVALID_HANDLE) return 0;
   double b[]; if(CopyBuffer(h,0,1,1,b)!=1){ IndicatorRelease(h); return 0; }
   IndicatorRelease(h); return b[0];
}
double H1ATRAt(string sym,int shift)
{
   int h=iATR(sym,PERIOD_H1,14); if(h==INVALID_HANDLE) return 0;
   double b[]; if(CopyBuffer(h,0,shift,1,b)!=1){ IndicatorRelease(h); return 0; }
   IndicatorRelease(h); return b[0];
}
double LotsFor(string sym,double slDist,double money)
{
   // 1ロットで損切りまで動いたときの損失（口座通貨）を MT5 に直接計算させる（ゴールド・銀も正確）
   MqlTick t; if(!SymbolInfoTick(sym,t) || slDist<=0) return 0;
   double loss1=0;
   if(!OrderCalcProfit(ORDER_TYPE_BUY,sym,1.0,t.ask,t.ask-slDist,loss1)) return 0;
   loss1=MathAbs(loss1); if(loss1<=0) return 0;
   double lots=money/loss1;
   double st=SymbolInfoDouble(sym,SYMBOL_VOLUME_STEP), mn=SymbolInfoDouble(sym,SYMBOL_VOLUME_MIN), mx=SymbolInfoDouble(sym,SYMBOL_VOLUME_MAX);
   lots=MathFloor(lots/st)*st;
   if(lots<mn) return 0;          // 最小ロットでもリスクを超える＝見送る
   if(lots*loss1 > money*1.05) return 0;   // 念のための安全確認
   return MathMin(lots,mx);
}
void LogFill(string sym,int dir,double want,double got,string tag);   // 後ろで定義
// dir=+1 買い / -1 売り。slDist は価格差。成功で true
bool Open(string sym,int dir,double slDist,double money,int magic,string cmt)
{
   MqlTick t; if(!SymbolInfoTick(sym,t)) return false;
   double spread=t.ask-t.bid;
   if(spread > slDist*InpMaxSpreadPct/100.0){ if(InpVerbose) Print(cmt," ",sym," スプレッドが広いので見送り"); return false; }
   double lots=LotsFor(sym,slDist,money);
   if(lots<=0){ if(InpVerbose) Print(cmt," ",sym," ロットが最小未満なので見送り"); return false; }
   int dg=(int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
   trade.SetExpertMagicNumber(magic);
   bool ok;
   if(dir>0) ok=trade.Buy (lots,sym,0,NormalizeDouble(t.ask-slDist,dg),0,cmt);
   else      ok=trade.Sell(lots,sym,0,NormalizeDouble(t.bid+slDist,dg),0,cmt);
   if(InpVerbose) Print(cmt," ",sym,(dir>0?" 買い ":" 売り "),DoubleToString(lots,2),"lot ",ok?"OK":"失敗 "+IntegerToString(trade.ResultRetcode()));
   if(ok && !MQLInfoInteger(MQL_TESTER))
   {
      double got=trade.ResultPrice(); ulong dl=trade.ResultDeal();
      if(got<=0 && dl>0 && HistoryDealSelect(dl)) got=HistoryDealGetDouble(dl,DEAL_PRICE);   // 業者によっては ResultPrice が0
      if(got>0) LogFill(sym,dir,(dir>0?t.ask:t.bid),got,cmt);
   }   // 成行の滑りも記録（月末・ゴトー日の確認用）
   return ok;
}
// 決済するときは、そのポジション自身のマジック番号で決済（決済の記録が正しい手法に付くように）
bool ClosePos(ulong tk)
{
   if(!PositionSelectByTicket(tk)) return false;
   trade.SetExpertMagicNumber((ulong)PositionGetInteger(POSITION_MAGIC));
   return trade.PositionClose(tk);
}
void CloseMagic(int magic)
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong tk=PositionGetTicket(i); if(!PositionSelectByTicket(tk)) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=magic) continue;
      ClosePos(tk);
   }
}
void CloseFOMCExpired()
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong tk=PositionGetTicket(i); if(!PositionSelectByTicket(tk)) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=MAGIC_FOMC) continue;
      if(TimeTradeServer() - (datetime)PositionGetInteger(POSITION_TIME) >= 24*3600) ClosePos(tk);
   }
}
bool Due(int idx,datetime local,int hh,int mi)   // その日の hh:mm（から2分以内）で、まだ実行していない
{
   MqlDateTime s; TimeToStruct(local,s);
   int nowm=s.hour*60+s.min, tgt=hh*60+mi;
   if(nowm<tgt || nowm>tgt+2) return false;
   if(g_doneKey[idx]==DateKey(local)) return false;
   g_doneKey[idx]=DateKey(local);
   return true;
}

//================== ⑤ ストラドル ======================================
datetime ParseUTC(string x){ StringTrimLeft(x); StringTrimRight(x); StringReplace(x,"-","."); return StringToTime(x); }
void AddEvents(string list,int kind,int hold)
{
   string p[]; int n=StringSplit(list,',',p);
   for(int i=0;i<n;i++){ datetime t=ParseUTC(p[i]); if(t<=0) continue;
      int k=ArraySize(g_ev); ArrayResize(g_ev,k+1); g_ev[k].relUTC=t; g_ev[k].kind=kind; g_ev[k].holdMin=hold; g_ev[k].placed=false; g_ev[k].closed=false; }
}
// 直前4時間の値幅 / 日足ATR（雇用統計は 0.31 未満の銘柄だけ）
double PreRangeRatio(string sym,double datr)
{
   // 本番: 研究どおり5分足48本（発表直前までの4時間）で計算
   // テスター: 5分足だと9銘柄分のデータ生成で容量オーバーするため、1時間足4本で代用
   double h[],l[]; if(datr<=0) return 99;
   if(MQLInfoInteger(MQL_TESTER)) { if(CopyHigh(sym,PERIOD_H1,1,4,h)<4 || CopyLow(sym,PERIOD_H1,1,4,l)<4) return 99; }
   else                           { if(CopyHigh(sym,PERIOD_M5,1,48,h)<48 || CopyLow(sym,PERIOD_M5,1,48,l)<48) return 99; }
   return (h[ArrayMaximum(h)]-l[ArrayMinimum(l)])/datr;
}
void LogFill(string sym,int dir,double want,double got,string tag)
{
   int f=FileOpen("flowea_fills.csv",FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI,',');
   if(f==INVALID_HANDLE) return; FileSeek(f,0,SEEK_END);
   double pip=(SymbolInfoInteger(sym,SYMBOL_DIGITS)%2==1)?SymbolInfoDouble(sym,SYMBOL_POINT)*10:SymbolInfoDouble(sym,SYMBOL_POINT);
   FileWrite(f,TimeToString(TimeTradeServer(),TIME_DATE|TIME_SECONDS),tag,sym,dir,DoubleToString(want,5),DoubleToString(got,5),DoubleToString(dir*(got-want)/pip,1));
   FileClose(f);
}
// 発表時点で分かっている最新の前年比（発表月の2か月前のデータ）。見つからなければ -999
double HistYoY(datetime relUTC)
{
   MqlDateTime t; TimeToStruct(relUTC,t); int y=t.year, m=t.mon-2; if(m<=0){ m+=12; y--; }
   string key=StringFormat("%04d.%02d:",y,m); int p=StringFind(HIST_YOY,key); if(p<0) return -999;
   int q=StringFind(HIST_YOY,",",p); string v=(q<0)?StringSubstr(HIST_YOY,p+8):StringSubstr(HIST_YOY,p+8,q-p-8);
   return StringToDouble(v);
}
bool POSTVixOK()
{
   if(InpUsePOSTVIX && MQLInfoInteger(MQL_TESTER))   // テスターでは本物のVIXの履歴を使う
   {
      MqlDateTime t; TimeToStruct(TimeTradeServer(),t);
      string key=StringFormat("%04d.%02d:",t.year,t.mon); int p=StringFind(HIST_VIXMTD,key);
      if(p<0) return true;
      bool ok=(StringSubstr(HIST_VIXMTD,p+8,1)=="D");
      if(InpVerbose) Print("③VIX判定(履歴) ",ok?"下落 → 取引":"上昇 → 見送り");
      return ok;
   }
   if(!InpUsePOSTVIX) return true;
   if(InpVIXSymbol=="") return true;
   string v="";
   if(SymbolSelect(InpVIXSymbol,true)) v=InpVIXSymbol;          // 名前どおりの銘柄を最優先（価格が読めればよい）
   else
   {
      v=Resolve(InpVIXSymbol);
      int bl=StringLen(InpVIXSymbol);
      if(v!="" && StringLen(v)>bl)                               // VIXY・VIXM など別銘柄（英字が続く）は使わない
      {
         ushort ch=StringGetCharacter(v,bl);
         if((ch>='A' && ch<='Z') || (ch>='a' && ch<='z')) v="";
      }
   }
   if(v==""){ Print("VIX銘柄が見つからないので③は通常どおり"); return true; }
   double c1=iClose(v,PERIOD_D1,1); if(c1<=0) return true;
   MqlDateTime t; TimeToStruct(TimeTradeServer(),t); t.day=1; t.hour=0; t.min=0; t.sec=0;
   int sh=iBarShift(v,PERIOD_D1,StructToTime(t)-1,false); if(sh<0) return true;
   double c0=iClose(v,PERIOD_D1,sh); if(c0<=0) return true;
   bool ok=(c1-c0)<0;
   if(InpVerbose) Print("③VIX判定 今月の変化 ",DoubleToString(c1-c0,2),ok?" → 取引":" → 見送り");
   return ok;
}
//================== 手法ごとの成績 =====================================
// 決済済みの取引を手法ごとに集計（テスター終了時と、EAを外した時に表示）
string ModName(long mg,string cmt)
{
   if(mg==MAGIC_GOTOBI) return "① ゴトー日";
   if(mg==MAGIC_ME)     return "② 月末ドル売り";
   if(mg==MAGIC_REB)    return "③ 月末ドル買い";
   if(mg==MAGIC_FOMC)   return "④ FOMC";
   if(mg==MAGIC_COT)    return "⑦ COT";
   if(mg==MAGIC_JPH)    return "⑧ 連休明け";
   if(mg==MAGIC_STR)
   {
      if(StringFind(cmt,"STR_CPI")==0)   return "⑤ 米CPI";
      if(StringFind(cmt,"STR_NFP")==0)   return "⑤ 雇用統計";
      if(StringFind(cmt,"STR_RBNZ")==0)  return "⑤ RBNZ";
      if(StringFind(cmt,"STR_CACPI")==0) return "⑥ カナダCPI";
      if(StringFind(cmt,"STR_AUCPI")==0) return "⑨ 豪CPI";
      return "⑤ ストラドル（その他）";
   }
   return "";
}
// 約定のコメント（空なら元の注文のコメント）。逆指値が約定した時にコメントが空になる業者向け
string DealCmt(ulong d)
{
   string c=HistoryDealGetString(d,DEAL_COMMENT);
   if(c=="") c=HistoryOrderGetString((ulong)HistoryDealGetInteger(d,DEAL_ORDER),ORDER_COMMENT);
   return c;
}
// 手法名 names[] ごとに 損益 pl[]・決済回数 cnt[]・勝ち win[] を集める
void ModuleStats(string &names[],double &pl[],int &cnt[],int &win[])
{
   ArrayResize(names,0); ArrayResize(pl,0); ArrayResize(cnt,0); ArrayResize(win,0);
   if(!HistorySelect(0,TimeCurrent()+86400)) return;
   int nd=HistoryDealsTotal();
   // ポジションID → 入った時のコメント
   long pids[]; string cmts[]; long pmg[]; ArrayResize(pids,0); ArrayResize(cmts,0); ArrayResize(pmg,0);
   for(int i=0;i<nd;i++){ ulong d=HistoryDealGetTicket(i); if(d==0) continue;
      if(HistoryDealGetInteger(d,DEAL_ENTRY)!=DEAL_ENTRY_IN) continue;
      int k=ArraySize(pids); ArrayResize(pids,k+1); ArrayResize(cmts,k+1); ArrayResize(pmg,k+1);
      pids[k]=HistoryDealGetInteger(d,DEAL_POSITION_ID); cmts[k]=DealCmt(d); pmg[k]=HistoryDealGetInteger(d,DEAL_MAGIC); }
   for(int i=0;i<nd;i++)
   {
      ulong d=HistoryDealGetTicket(i); if(d==0) continue;
      // 手法は「入った時」のマジック番号とコメントで判定（決済の記録のマジックは当てにしない）
      long pid=HistoryDealGetInteger(d,DEAL_POSITION_ID); string c=""; long mg=-1;
      for(int q=ArraySize(pids)-1;q>=0;q--) if(pids[q]==pid){ c=cmts[q]; mg=pmg[q]; break; }
      if(mg<91001 || mg>91007) continue;
      string nm=ModName(mg,c); if(nm=="") continue;
      int k=-1; for(int j=0;j<ArraySize(names);j++) if(names[j]==nm){ k=j; break; }
      if(k<0){ k=ArraySize(names); ArrayResize(names,k+1); ArrayResize(pl,k+1); ArrayResize(cnt,k+1); ArrayResize(win,k+1); names[k]=nm; pl[k]=0; cnt[k]=0; win[k]=0; }
      double p=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_SWAP)+HistoryDealGetDouble(d,DEAL_COMMISSION);
      pl[k]+=p;
      long en=HistoryDealGetInteger(d,DEAL_ENTRY);
      if(en==DEAL_ENTRY_OUT || en==DEAL_ENTRY_INOUT || en==DEAL_ENTRY_OUT_BY){ cnt[k]++; if(p>0) win[k]++; }
   }
}
void PrintModuleStats()
{
   string nm[]; double pl[]; int cnt[], win[];
   ModuleStats(nm,pl,cnt,win);
   Print("===== 手法ごとの成績（決済済み・スワップ手数料込み）=====");
   int f=FileOpen("flowea_modules.csv",FILE_WRITE|FILE_CSV|FILE_UNICODE,',');
   if(f!=INVALID_HANDLE) FileWrite(f,"手法","決済回数","勝率%","損益");
   for(int i=0;i<ArraySize(nm);i++)
   {
      double wr=cnt[i]>0?100.0*win[i]/cnt[i]:0;
      Print(StringFormat("%s : %d回  勝率 %.0f%%  損益 %s",nm[i],cnt[i],wr,DoubleToString(pl[i],0)));
      if(f!=INVALID_HANDLE) FileWrite(f,nm[i],cnt[i],DoubleToString(wr,0),DoubleToString(pl[i],0));
   }
   if(f!=INVALID_HANDLE) FileClose(f);
}
// ⑥ 停止ルール：カナダCPIを InpCACPIKillN 回以上やって合計が赤字なら true
bool CACPIKilled()
{
   if(!InpCACPIKill) return false;
   if(!HistorySelect(0,TimeCurrent()+86400)) return false;
   int nd=HistoryDealsTotal(); long pids[]; ArrayResize(pids,0);
   for(int i=0;i<nd;i++){ ulong d=HistoryDealGetTicket(i); if(d==0) continue;
      if(HistoryDealGetInteger(d,DEAL_MAGIC)!=MAGIC_STR || HistoryDealGetInteger(d,DEAL_ENTRY)!=DEAL_ENTRY_IN) continue;
      if(StringFind(DealCmt(d),"STR_CACPI")!=0) continue;
      int k=ArraySize(pids); ArrayResize(pids,k+1); pids[k]=HistoryDealGetInteger(d,DEAL_POSITION_ID); }
   int n=ArraySize(pids); if(n<InpCACPIKillN) return false;
   double pl=0;
   for(int i=0;i<nd;i++){ ulong d=HistoryDealGetTicket(i); if(d==0) continue;
      long pid=HistoryDealGetInteger(d,DEAL_POSITION_ID); bool hit=false;
      for(int q=0;q<n;q++) if(pids[q]==pid){ hit=true; break; }
      if(hit) pl+=HistoryDealGetDouble(d,DEAL_PROFIT)+HistoryDealGetDouble(d,DEAL_SWAP)+HistoryDealGetDouble(d,DEAL_COMMISSION); }
   if(pl<0){ if(InpVerbose) Print("⑥ カナダCPI：",n,"回で合計赤字(",DoubleToString(pl,0),")のため停止中"); return true; }
   return false;
}
void PlaceStraddle(int e)
{
   if(g_ev[e].kind==4 && CACPIKilled()) return;
   if(g_ev[e].kind==1 && InpUSCPIYoY>0)
   {
      double yy=MQLInfoInteger(MQL_TESTER)?HistYoY(g_ev[e].relUTC):InpUSCPIYoY;   // テスターでは当時の数字を使う
      if(yy>-900 && yy<=3.0){ if(InpVerbose) Print("米CPI前年比 ",DoubleToString(yy,1),"% ≤ 3% のため米CPIストラドルは休み"); return; }
   }
   string syms[]; int n=0;
   if(g_ev[e].kind==3){ ArrayResize(syms,1); syms[0]=USD8[3]; n=1; }        // RBNZ → NZDUSD
   else if(g_ev[e].kind==4){ ArrayResize(syms,1); syms[0]=USD8[6]; n=1; }   // カナダCPI → USDCAD
   else if(g_ev[e].kind==5){ ArrayResize(syms,1); syms[0]=USD8[2]; n=1; }   // 豪CPI → AUDUSD
   else { n=ArraySize(USD8); ArrayResize(syms,n); for(int i=0;i<n;i++) syms[i]=USD8[i]; }
   string tag=(g_ev[e].kind==1?"STR_CPI":g_ev[e].kind==2?"STR_NFP":g_ev[e].kind==3?"STR_RBNZ":g_ev[e].kind==5?"STR_AUCPI":"STR_CACPI");
   // 対象銘柄を先に決める（雇用統計は静かな銘柄だけ）
   string use[]; double at[]; int m=0;
   for(int i=0;i<n;i++)
   {
      double a=DailyATR(syms[i]); if(a<=0) continue;
      if((g_ev[e].kind==2 || g_ev[e].kind==5) && PreRangeRatio(syms[i],a)>=0.31) continue;   // 雇用統計・豪CPIは静かな日だけ
      if(g_ev[e].kind==2 && InpPrune && i==3) continue;   // 雇用統計の NZDUSD は外す（コスト負け）
      ArrayResize(use,m+1); ArrayResize(at,m+1); use[m]=syms[i]; at[m]=a; m++;
   }
   if(m==0){ if(InpVerbose) Print(tag," 条件を満たす銘柄なし"); return; }
   double wk=(g_ev[e].kind==1 || g_ev[e].kind==4)?InpWeakMul:1.0;   // 米CPI・カナダCPIは弱い側
   double money=AccountInfoDouble(ACCOUNT_BALANCE)*RiskPct()*wk/100.0/m;
   datetime expSrv=UTCToServer(g_ev[e].relUTC)+g_ev[e].holdMin*60;
   for(int i=0;i<m;i++)
   {
      string sym=use[i]; MqlTick t; if(!SymbolInfoTick(sym,t)) continue;
      int dg=(int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
      double k=0.1*at[i], p0=(t.bid+t.ask)/2.0, up=NormalizeDouble(p0+k,dg), dn=NormalizeDouble(p0-k,dg);
      if(t.ask-t.bid > 2*k*InpMaxSpreadPct/100.0){ if(InpVerbose) Print(tag," ",sym," スプレッドが広いので見送り"); continue; }
      double lots=LotsFor(sym,2*k,money); if(lots<=0){ if(InpVerbose) Print(tag," ",sym," ロット不足で見送り"); continue; }
      trade.SetExpertMagicNumber(MAGIC_STR);
      trade.BuyStop (lots,up,sym,dn,0,ORDER_TIME_SPECIFIED,expSrv,tag);
      trade.SellStop(lots,dn,sym,up,0,ORDER_TIME_SPECIFIED,expSrv,tag);
      if(InpVerbose) Print(tag," ",sym," 逆指値 上 ",up," 下 ",dn," ",DoubleToString(lots,2),"lot");
   }
}
// 片方が約定したら反対側の逆指値を消す＋約定価格を記録
void ManageStraddles()
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong tk=PositionGetTicket(i); if(!PositionSelectByTicket(tk)) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=MAGIC_STR) continue;
      string sym=PositionGetString(POSITION_SYMBOL);
      for(int j=OrdersTotal()-1;j>=0;j--)
      {
         ulong ot=OrderGetTicket(j); if(!OrderSelect(ot)) continue;
         if(OrderGetInteger(ORDER_MAGIC)!=MAGIC_STR || OrderGetString(ORDER_SYMBOL)!=sym) continue;
         int pdir=(PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY)?1:-1;
         double want=OrderGetDouble(ORDER_SL);   // 残った側の損切り価格 = 約定した側の本来の逆指値の価格
         trade.OrderDelete(ot);
         LogFill(sym,pdir,want,PositionGetDouble(POSITION_PRICE_OPEN),PositionGetString(POSITION_COMMENT));
      }
   }
}
void CloseStraddleExpired()
{
   datetime utc=NowUTC();
   for(int e=0;e<ArraySize(g_ev);e++)
   {
      if(!g_ev[e].placed || g_ev[e].closed) continue;
      if(utc >= g_ev[e].relUTC + g_ev[e].holdMin*60)
      {
         // その指標のものだけ決済（同じ日に別の指標がある日に、長く持つ方まで早く閉じないように）
         int k=g_ev[e].kind;
         string tg=(k==1?"STR_CPI":k==2?"STR_NFP":k==3?"STR_RBNZ":k==5?"STR_AUCPI":"STR_CACPI");
         for(int i=PositionsTotal()-1;i>=0;i--){ ulong tk=PositionGetTicket(i); if(!PositionSelectByTicket(tk) || PositionGetInteger(POSITION_MAGIC)!=MAGIC_STR) continue;
            string c=PositionGetString(POSITION_COMMENT);
            if(c==tg || StringFind(c,"STR_")!=0) ClosePos(tk); }   // コメントが書き換えられていたら念のため決済
         for(int j=OrdersTotal()-1;j>=0;j--){ ulong ot=OrderGetTicket(j); if(!OrderSelect(ot) || OrderGetInteger(ORDER_MAGIC)!=MAGIC_STR) continue;
            string c=OrderGetString(ORDER_COMMENT);
            if(c==tg || StringFind(c,"STR_")!=0) trade.OrderDelete(ot); }
         g_ev[e].closed=true;
      }
   }
}


//================== ⑦ COT逆張り ======================================
string SYMS[] = {"AUDCAD","AUDCHF","AUDJPY","AUDNZD","AUDUSD","CADCHF","CADJPY","CHFJPY","EURAUD","EURCAD","EURCHF","EURGBP",
                 "EURJPY","EURNZD","EURUSD","GBPAUD","GBPCAD","GBPCHF","GBPJPY","GBPNZD","GBPUSD","NZDCAD","NZDCHF","NZDJPY",
                 "NZDUSD","USDCAD","USDCHF","USDJPY","XAUUSD"};
string REAL[]; bool g_doneSym[]; long g_rebWeek=-1; bool g_cotOK=false; datetime g_lastCOT=0;
string   c_ccy[]; datetime c_asof[]; datetime c_rel[]; double c_net[]; double c_z[];
datetime g_lastFetch=0;
//================== COTデータ =========================================
bool LoadCOT()
{
   ArrayResize(c_ccy,0); ArrayResize(c_asof,0); ArrayResize(c_rel,0); ArrayResize(c_net,0); ArrayResize(c_z,0);
   int f=FileOpen("cot_hist.csv",FILE_READ|FILE_TXT|FILE_ANSI|FILE_SHARE_READ);
   if(f==INVALID_HANDLE){ Print("cot_hist.csv が見つかりません（MQL5/Files に入れてください）"); return false; }
   while(!FileIsEnding(f))
   {
      string ln=FileReadString(f); if(StringLen(ln)<10) continue;
      string p[]; if(StringSplit(ln,',',p)<4) continue;
      int k=ArraySize(c_ccy);
      ArrayResize(c_ccy,k+1); ArrayResize(c_asof,k+1); ArrayResize(c_rel,k+1); ArrayResize(c_net,k+1); ArrayResize(c_z,k+1);
      c_ccy[k]=p[0]; c_asof[k]=StringToTime(p[1]); c_rel[k]=StringToTime(p[2]); c_net[k]=StringToDouble(p[3]);
      c_z[k]=(ArraySize(p)>=5 && StringLen(p[4])>0)? StringToDouble(p[4]) : EMPTY_VALUE;
   }
   FileClose(f);
   Print("COTデータ読み込み: ",ArraySize(c_ccy)," 行");
   return ArraySize(c_ccy)>0;
}
// 今使える最新のz（USD=0、13日より古いデータは使わない）
bool GetZ(string ccy,datetime utc,double &z)
{
   if(ccy=="USD"){ z=0; return true; }
   int best=-1;
   for(int i=0;i<ArraySize(c_ccy);i++)
      if(c_ccy[i]==ccy && c_rel[i]<=utc && (best<0 || c_rel[i]>c_rel[best])) best=i;
   if(best<0 || c_z[best]==EMPTY_VALUE) return false;
   if(utc - c_asof[best] > 13*86400) return false;
   z=c_z[best]; return true;
}
datetime LatestAsof(string ccy)
{
   datetime m=0; for(int i=0;i<ArraySize(c_ccy);i++) if(c_ccy[i]==ccy && c_asof[i]>m) m=c_asof[i]; return m;
}
double ZFromNets(string ccy,double newNet)   // 直近155本 + 新しい1本 = 156週のz
{
   double v[]; int n=0;
   // asof順に並んだ過去の値を集める
   for(int i=0;i<ArraySize(c_ccy);i++) if(c_ccy[i]==ccy){ ArrayResize(v,n+1); v[n]=c_net[i]; n++; }
   if(n<155) return EMPTY_VALUE;
   double w[156]; for(int j=0;j<155;j++) w[j]=v[n-155+j]; w[155]=newNet;
   double m=0; for(int j=0;j<156;j++) m+=w[j]; m/=156;
   double s=0; for(int j=0;j<156;j++) s+=(w[j]-m)*(w[j]-m); s=MathSqrt(s/155);
   return s>0 ? (newNet-m)/s : EMPTY_VALUE;
}
string JsonVal(string obj,string key)   // "key...":"value" の value
{
   int p=StringFind(obj,"\""+key); if(p<0) return "";
   int c=StringFind(obj,":",p); if(c<0) return "";
   int a=c+1; while(a<StringLen(obj) && (StringGetCharacter(obj,a)==' '||StringGetCharacter(obj,a)=='"')) a++;
   int b=a; while(b<StringLen(obj)){ ushort ch=StringGetCharacter(obj,b); if(ch=='"'||ch==','||ch=='}') break; b++; }
   return StringSubstr(obj,a,b-a);
}
void AppendRow(string ccy,datetime asof,datetime rel,double net,double z)
{
   int k=ArraySize(c_ccy);
   ArrayResize(c_ccy,k+1); ArrayResize(c_asof,k+1); ArrayResize(c_rel,k+1); ArrayResize(c_net,k+1); ArrayResize(c_z,k+1);
   c_ccy[k]=ccy; c_asof[k]=asof; c_rel[k]=rel; c_net[k]=net; c_z[k]=z;
   int f=FileOpen("cot_hist.csv",FILE_READ|FILE_WRITE|FILE_TXT|FILE_ANSI);
   if(f==INVALID_HANDLE) return; FileSeek(f,0,SEEK_END);
   FileWriteString(f,StringFormat("%s,%s,%s,%.0f,%s\n",ccy,TimeToString(asof,TIME_DATE),TimeToString(rel,TIME_DATE|TIME_MINUTES),net,
                   z==EMPTY_VALUE?"":DoubleToString(z,4)));
   FileClose(f);
}
// CFTC公式APIから最新の数週分を取得して追加
void FetchCOT()
{
   string cc[]={"EUR","GBP","JPY","CHF","CAD","AUD","NZD","XAU"};
   string code[]={"099741","096742","097741","092741","090741","232741","112741","088691"};
   for(int i=0;i<ArraySize(cc);i++)
   {
      bool gold=(cc[i]=="XAU");
      string url="https://publicreporting.cftc.gov/resource/"+(gold?"72hh-3qpy":"gpe5-46if")+".json?cftc_contract_market_code="+code[i]
                 +"&$order=report_date_as_yyyy_mm_dd%20DESC&$limit=4";
      char data[],res[]; string hdr;
      int r=WebRequest("GET",url,"",10000,data,res,hdr);
      if(r!=200){ Print("COT取得に失敗(",cc[i],") code=",r," err=",GetLastError(),"  → オプションでURLの許可を確認してください"); return; }
      string js=CharArrayToString(res,0,WHOLE_ARRAY,CP_UTF8);
      // 古い順に処理するため、オブジェクトを集めて逆順に
      string objs[]; int n=0, pos=0;
      while(true){ int a=StringFind(js,"{",pos); if(a<0) break; int b=StringFind(js,"}",a); if(b<0) break;
                   ArrayResize(objs,n+1); objs[n]=StringSubstr(js,a,b-a+1); n++; pos=b+1; }
      for(int j=n-1;j>=0;j--)
      {
         string d=StringSubstr(JsonVal(objs[j],"report_date_as_yyyy_mm_dd"),0,10); StringReplace(d,"-",".");
         datetime asof=StringToTime(d); if(asof<=0 || asof<=LatestAsof(cc[i])) continue;
         double L=StringToDouble(JsonVal(objs[j],gold?"m_money_positions_long":"asset_mgr_positions_long"));
         double S=StringToDouble(JsonVal(objs[j],gold?"m_money_positions_short":"asset_mgr_positions_short"));
         datetime fri=asof+3*86400+15*3600+30*60;                 // 金曜15:30(ET)
         datetime rel=fri + (IsUSDST(fri+5*3600)?4:5)*3600;        // → UTC
         double net=L-S, z=ZFromNets(cc[i],net);
         AppendRow(cc[i],asof,rel,net,z);
         Print("COT更新: ",cc[i]," ",d," net=",net," z=",z==EMPTY_VALUE?"-":DoubleToString(z,2));
      }
   }
}

// 週の始まり（日曜18:00 NY）
datetime WeekStartNY(datetime ny)
{
   datetime d=ny-(ny%86400); int w=DowOf(d);
   datetime s=d-w*86400+18*3600;            // その週の日曜18:00
   if(ny<s) s-=7*86400;
   return s;
}
void CloseCohort(string tag)
{
   for(int i=PositionsTotal()-1;i>=0;i--){ ulong tk=PositionGetTicket(i); if(!PositionSelectByTicket(tk)) continue;
      if(PositionGetInteger(POSITION_MAGIC)==MAGIC_COT && PositionGetString(POSITION_COMMENT)==tag) ClosePos(tk); }
}
void Rebalance(datetime utc,datetime ny,long wk)
{
   string tag="COT"+IntegerToString((int)(wk%4));   // 4グループのうち今週のグループ
   if(g_rebWeek!=wk)
   {
      CloseCohort(tag);                      // 4週間前に入った同じグループを決済
      ArrayInitialize(g_doneSym,false);
      g_rebWeek=wk;
      if(InpVerbose) Print("COT入替 ",tag,"（週番号 ",wk,"）");
   }
   double bal=AccountInfoDouble(ACCOUNT_BALANCE);
   for(int i=0;i<ArraySize(SYMS);i++)
   {
      if(g_doneSym[i] || REAL[i]=="") continue;
      string base=StringSubstr(SYMS[i],0,3), quote=StringSubstr(SYMS[i],3,3);
      double zb,zq;
      if(!GetZ(base,utc,zb) || !GetZ(quote,utc,zq)){ g_doneSym[i]=true; continue; }
      double score=-(zb-zq);                 // 逆張り
      if(MathAbs(score)<=InpCOTThreshold){ g_doneSym[i]=true; continue; }
      int dir=score>0?1:-1;
      double a=DailyATR(REAL[i]); if(a<=0) continue;
      double sl=3.0*a;
      MqlTick t; if(!SymbolInfoTick(REAL[i],t)) continue;
      if(t.ask-t.bid > 0.05*sl) continue;   // 週明け直後でスプレッドが広い → 少し待って再挑戦
      double lots=LotsFor(REAL[i],sl,bal*InpCOTRiskPct*RiskMult()/100.0);
      g_doneSym[i]=true;
      if(lots<=0){ if(InpVerbose) Print("COT ",REAL[i]," ロット不足で見送り"); continue; }
      int dg=(int)SymbolInfoInteger(REAL[i],SYMBOL_DIGITS);
      trade.SetExpertMagicNumber(MAGIC_COT);
      bool ok = dir>0 ? trade.Buy(lots,REAL[i],0,NormalizeDouble(t.ask-sl,dg),0,tag)
                      : trade.Sell(lots,REAL[i],0,NormalizeDouble(t.bid+sl,dg),0,tag);
      if(InpVerbose) Print(tag," ",REAL[i],dir>0?" 買い ":" 売り ",DoubleToString(lots,2),"lot  score=",DoubleToString(score,2)," ",ok?"OK":"失敗");
   }
}


void COTInit()
{
   if(!InpUseCOT) return;
   int n=ArraySize(SYMS); ArrayResize(REAL,n); ArrayResize(g_doneSym,n); ArrayInitialize(g_doneSym,false);
   for(int i=0;i<n;i++){ REAL[i]=Resolve(SYMS[i]); if(REAL[i]=="") Print("COT 銘柄が見つかりません: ",SYMS[i]); }
   g_cotOK=LoadCOT();
   if(!g_cotOK) Print("COTデータがないため ⑦ は動きません（cot_hist.csv を MQL5/Files に入れてください）");
}
void COTStep()
{
   if(!InpUseCOT || !g_cotOK) return;
   if(TimeTradeServer()-g_lastCOT<30) return;      // 30秒おきに確認
   g_lastCOT=TimeTradeServer();
   datetime utc=NowUTC(), ny=ToNY(utc);
   if(InpCOTAutoUpdate && !MQLInfoInteger(MQL_TESTER) && TimeLocal()-g_lastFetch>6*3600)
   { g_lastFetch=TimeLocal(); if(utc-LatestAsof("EUR")>9*86400) FetchCOT(); }
   datetime ws=WeekStartNY(ny), anchor=MakeT(2016,1,3,18,0);
   long wk=(long)((ws-anchor)/(7*86400));
   if(ny>=ws && ny<ws+6*3600) Rebalance(utc,ny,wk);
}

//================== 仮想売買（シャドー）=================================
double g_shJ_e=0,g_shJ_sl=0; datetime g_shJ_t=0;   // ⑧ 連休明け 8:15買い→9:55
double g_shG_e=0,g_shG_sl=0; datetime g_shG_t=0;   // ゴトー日 9:55売り→11:30
void ShadowWrite(string tag,double e,double x,double sl,bool hit,double pip)
{
   int f=FileOpen("flowea_shadow.csv",FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI,',');
   if(f==INVALID_HANDLE) return; FileSeek(f,0,SEEK_END);
   double slp=MathAbs(e-sl)/pip; double pp=hit?-slp:(tag=="SH_JPHOL"?(x-e):(e-x))/pip;
   FileWrite(f,TimeToString(TimeTradeServer(),TIME_DATE|TIME_MINUTES),tag,DoubleToString(e,3),DoubleToString(x,3),hit?"SL":"時間",DoubleToString(pp,1),DoubleToString(slp>0?pp/slp:0,2));
   FileClose(f);
   if(InpVerbose) Print("仮想 ",tag," ",DoubleToString(pp,1),"pips");
}
// 保有中に損切りに触れたか（1分足で確認）。dir=+1 買い / -1 売り
bool ShadowHit(string sym,datetime from,int dir,double sl)
{
   MqlRates r[]; int n=CopyRates(sym,PERIOD_M1,from,TimeTradeServer(),r); if(n<=0) return false;
   for(int i=0;i<n;i++){ if(dir>0 && r[i].low<=sl) return true; if(dir<0 && r[i].high+r[i].spread*SymbolInfoDouble(sym,SYMBOL_POINT)>=sl) return true; }
   return false;
}

//================== スプレッドの安全装置（①③）===========================
// 普段のスプレッドを1秒ごとに測って覚える（ゆっくり動く平均。ロールオーバー前後と週末は除外）
string g_spSym[]; double g_spBase[]; int g_spN[];
double PipSize(string sym){ return (SymbolInfoInteger(sym,SYMBOL_DIGITS)%2==1)?SymbolInfoDouble(sym,SYMBOL_POINT)*10:SymbolInfoDouble(sym,SYMBOL_POINT); }
double SpreadPips(string sym){ MqlTick t; if(!SymbolInfoTick(sym,t) || t.bid<=0) return -1; return (t.ask-t.bid)/PipSize(sym); }
int SpIdx(string sym)
{
   for(int i=0;i<ArraySize(g_spSym);i++) if(g_spSym[i]==sym) return i;
   int k=ArraySize(g_spSym); ArrayResize(g_spSym,k+1); ArrayResize(g_spBase,k+1); ArrayResize(g_spN,k+1);
   g_spSym[k]=sym; g_spBase[k]=0; g_spN[k]=0; return k;
}
void SpreadSample()
{
   datetime ny=ToNY(NowUTC()); MqlDateTime n; TimeToStruct(ny,n);
   int hm=n.hour*60+n.min;
   if(n.day_of_week==0 || n.day_of_week==6) return;
   if(hm>=16*60+30 && hm<=18*60+30) return;                 // NY 16:30〜18:30（ロールオーバー）は除外
   for(int i=0;i<ArraySize(USD8);i++)
   {
      double sp=SpreadPips(USD8[i]); if(sp<=0) continue;
      int k=SpIdx(USD8[i]);
      if(g_spN[k]==0) g_spBase[k]=sp; else g_spBase[k]+= (sp-g_spBase[k])/3600.0;   // 約1時間でならす
      g_spN[k]++;
   }
}
double SpreadBase(string sym){ int k=SpIdx(sym); return (g_spN[k]>=600)?g_spBase[k]:0; }   // 10分以上測れていなければ 0（判定しない）
// 見送った取引を仮想で記録（あとで「見送って正解だったか」を確かめる）
struct VTrade { string sym; string tag; int dir; double e; double sl; datetime t0; datetime t1; };
VTrade g_vt[];
void AddVirtual(string sym,string tag,int dir,double slDist,int holdMin)
{
   if(!InpShadow) return;
   MqlTick t; if(!SymbolInfoTick(sym,t)) return;
   int k=ArraySize(g_vt); ArrayResize(g_vt,k+1);
   g_vt[k].sym=sym; g_vt[k].tag=tag; g_vt[k].dir=dir; g_vt[k].e=(dir>0?t.ask:t.bid);
   g_vt[k].sl=(dir>0?g_vt[k].e-slDist:g_vt[k].e+slDist); g_vt[k].t0=TimeTradeServer(); g_vt[k].t1=TimeTradeServer()+holdMin*60;
}
void VirtualStep()
{
   for(int i=ArraySize(g_vt)-1;i>=0;i--)
   {
      if(TimeTradeServer()<g_vt[i].t1) continue;
      MqlTick t; if(!SymbolInfoTick(g_vt[i].sym,t)) continue;
      double pip=PipSize(g_vt[i].sym), x=(g_vt[i].dir>0?t.bid:t.ask);
      bool hit=ShadowHit(g_vt[i].sym,g_vt[i].t0,g_vt[i].dir,g_vt[i].sl);
      double slp=MathAbs(g_vt[i].e-g_vt[i].sl)/pip, pp=hit?-slp:g_vt[i].dir*(x-g_vt[i].e)/pip;
      int f=FileOpen("flowea_shadow.csv",FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI,',');
      if(f!=INVALID_HANDLE){ FileSeek(f,0,SEEK_END);
         FileWrite(f,TimeToString(TimeTradeServer(),TIME_DATE|TIME_MINUTES),g_vt[i].tag+"_"+g_vt[i].sym,DoubleToString(g_vt[i].e,5),DoubleToString(x,5),hit?"SL":"時間",DoubleToString(pp,1),DoubleToString(slp>0?pp/slp:0,2));
         FileClose(f); }
      if(InpVerbose) Print("仮想(見送り分) ",g_vt[i].tag," ",g_vt[i].sym," ",DoubleToString(pp,1),"pips");
      for(int j=i;j<ArraySize(g_vt)-1;j++) g_vt[j]=g_vt[j+1];
      ArrayResize(g_vt,ArraySize(g_vt)-1);
   }
}
void ShadowStep(datetime jst,datetime jstDay)
{
   if(!InpShadow) return;
   string s=USD9[6]; double pip=(SymbolInfoInteger(s,SYMBOL_DIGITS)%2==1)?SymbolInfoDouble(s,SYMBOL_POINT)*10:SymbolInfoDouble(s,SYMBOL_POINT);
   MqlTick t; if(!SymbolInfoTick(s,t)) return;
   if(IsJPHolAfter(jstDay))
   {
      if(Due(10,jst,8,15)){ double a=DailyATR(s); if(a>0){ g_shJ_e=t.ask; g_shJ_sl=t.ask-0.15*a; g_shJ_t=TimeTradeServer(); } }
      if(Due(11,jst,9,55) && g_shJ_t>0 && TimeTradeServer()-g_shJ_t<6*3600){ bool h=ShadowHit(s,g_shJ_t,1,g_shJ_sl); ShadowWrite("SH_JPHOL",g_shJ_e,t.bid,g_shJ_sl,h,pip); g_shJ_t=0; }
   }
   if(IsGotobi(jstDay))
   {
      if(Due(12,jst,9,55) && (jst%3600)<=55*60+20){ double a=DailyATR(s); if(a>0){ g_shG_e=t.bid; g_shG_sl=t.bid+0.15*a; g_shG_t=TimeTradeServer(); } }
      if(Due(13,jst,11,30) && g_shG_t>0 && TimeTradeServer()-g_shG_t<6*3600){ bool h=ShadowHit(s,g_shG_t,-1,g_shG_sl); ShadowWrite("SH_GOTO1130",g_shG_e,t.ask,g_shG_sl,h,pip); g_shG_t=0; }
   }
}
//================== 本体 ============================================
int OnInit()
{
   ArrayInitialize(g_doneKey,0);
   for(int i=0;i<ArraySize(USD9);i++){ string r=Resolve(USD9[i]); if(r=="") Print("銘柄が見つかりません: ",USD9[i]); else USD9[i]=r; }
   for(int i=0;i<ArraySize(USD8);i++){ string r=Resolve(USD8[i]); if(r!="") USD8[i]=r; }
   ArrayResize(g_ev,0);
   AddEvents(InpCPITimes,1,60); AddEvents(InpNFPTimes,2,60); AddEvents(InpRBNZTimes,3,30);
   AddEvents(HIST_CPI,1,60); AddEvents(HIST_NFP,2,60); AddEvents(HIST_RBNZ,3,30);
   AddEvents(H09_CPI,1,60); AddEvents(H09_NFP,2,60); AddEvents(H09_RBNZ,3,30);
   if(InpUseCACPI){ AddEvents(InpCACPITimes,4,30); AddEvents(HIST_CACPI,4,30); }
   if(InpUseAUCPI){ AddEvents(InpAUCPITimes,5,60); AddEvents(HIST_AUCPI,5,60); AddEvents(H09_AUCPI,5,60); }
   COTInit();
   ThrottleInit();
   EventSetTimer(1);
   Comment("FlowEA3 動作中（ゴトー日/月末/FOMC/指標/カナダCPI/豪CPI/COT＋守り",InpUseJPHol?"＋連休明け":"","）");
   return INIT_SUCCEEDED;
}
void OnDeinit(const int r){ EventKillTimer(); Comment(""); if(!MQLInfoInteger(MQL_TESTER)) PrintModuleStats(); }
double OnTester(){ PrintModuleStats(); return 0; }   // テスター終了時に「操作ログ」へ手法ごとの成績を表示
void OnTick(){ COTStep(); }   // 「始値のみ」テストでもCOTが動くように

void OnTimer()
{
   datetime utc=NowUTC(), lon=ToLondon(utc), ny=ToNY(utc), jst=ToTokyo(utc);
   datetime lonDay=lon-(lon%86400), jstDay=jst-(jst%86400), nyDay=ny-(ny%86400);
   double bal=AccountInfoDouble(ACCOUNT_BALANCE);
   RiskMult();   // 守り：最高値を毎秒追跡（決済で一時的に付けた最高値も取りこぼさない）

   //--- ① ゴトー日：東京 9:55 売り → 10:30 決済
   if(InpUseGotobi && IsGotobi(jstDay))
   {
      if(Due(0,jst,9,55) && (jst%3600)<=55*60+20)   // 9:55:20 を過ぎたら見送り（1分遅れると期待値がマイナス）
      {
         string s=USD9[6]; double a=DailyATR(s);
         double spg=SpreadPips(s);
         if(a>0 && InpGotobiMaxSpread>0 && spg>=InpGotobiMaxSpread)
         { if(InpVerbose) Print("GOTOBI スプレッド ",DoubleToString(spg,1),"pips ≥ ",DoubleToString(InpGotobiMaxSpread,1)," のため見送り"); AddVirtual(s,"SKIP_GOTOBI",-1,0.15*a,35); }
         else if(a>0) Open(s,-1,0.15*a,bal*RiskPct()*InpWeakMul/100.0,MAGIC_GOTOBI,"GOTOBI");
      }
      if(Due(1,jst,10,30)) CloseMagic(MAGIC_GOTOBI);
   }
   SpreadSample(); VirtualStep();
   ShadowStep(jst,jstDay);
   //--- ⑧ 連休明け：東京 8:15 ドル円買い → 9:55 決済
   if(InpUseJPHol && IsJPHolAfter(jstDay))
   {
      if(Due(8,jst,8,15))
      {
         string s=USD9[6]; double a=DailyATR(s);
         if(a>0) Open(s,1,0.15*a,bal*InpJPHolRiskPct*RiskMult()/100.0,MAGIC_JPH,"JPHOL");
      }
      if(Due(9,jst,9,55)) CloseMagic(MAGIC_JPH);
   }
   //--- ② 月末：ロンドン 14:00 ドル売り → 16:00 決済
   if(InpUseMonthEnd && IsLastBizDay(lonDay))
   {
      if(Due(2,lon,14,0))
      {
         int nME=InpPrune?6:ArraySize(USD9);
         double m=bal*RiskPct()*InpWeakMul/100.0/nME;
         for(int i=0;i<ArraySize(USD9);i++)
         {
            if(InpPrune && (i==2 || i==3 || i==5)) continue;   // AUDUSD・NZDUSD・銀は外す（実コストで負け）
            double a=DailyATR(USD9[i]); if(a>0) Open(USD9[i],-USDSG[i],0.5*a,m,MAGIC_ME,"MONTHEND");
         }
      }
      if(Due(3,lon,16,0)) CloseMagic(MAGIC_ME);
   }
   //--- ③ 月末：ロンドン 16:00 ドル買い → 16:30 決済
   if(InpUseRebound && IsLastBizDay(lonDay))
   {
      if(Due(4,lon,16,0) && (lon%3600)<=60 && POSTVixOK())   // 16:00:00〜16:01:00 に入れなければ今月は見送り（仲値後の反発は16:02半以降は消える）
      {
         double m=bal*RiskPct()*InpWeakMul/100.0/ArraySize(USD8);
         for(int i=0;i<ArraySize(USD8);i++)
         {
            double a=DailyATR(USD8[i]); if(a<=0) continue;
            double sp=SpreadPips(USD8[i]), bs=SpreadBase(USD8[i]);
            if(InpPostSpreadMul>0 && bs>0 && sp>=InpPostSpreadMul*bs)
            { if(InpVerbose) Print("REBOUND ",USD8[i]," スプレッド ",DoubleToString(sp,1)," ≥ 普段",DoubleToString(bs,1),"×",DoubleToString(InpPostSpreadMul,1)," のため見送り"); AddVirtual(USD8[i],"SKIP_REBOUND",USDSG8[i],0.3*a,30); continue; }
            Open(USD8[i],USDSG8[i],0.3*a,m,MAGIC_REB,"REBOUND");
         }
      }
      if(Due(5,lon,16,30)) CloseMagic(MAGIC_REB);
   }
   //--- ④ FOMC：NY 15:00（14時台の1時間足が確定）に判定 → 24時間後に決済
   if(InpUseFOMC && IsFOMCDay(nyDay) && Due(6,ny,15,0))
   {
      datetime evUTC = utc - (utc%3600) - 3600;           // 14:00 ET の足（UTC）
      datetime evSrv = UTCToServer(evUTC);
      int cnt=0; int dirs[]; double sls[]; string syms[];
      ArrayResize(dirs,0); ArrayResize(sls,0); ArrayResize(syms,0);
      for(int i=0;i<ArraySize(USD9);i++)
      {
         string s=USD9[i]; int sh=iBarShift(s,PERIOD_H1,evSrv,true); if(sh<1) continue;
         double o=iOpen(s,PERIOD_H1,sh), c=iClose(s,PERIOD_H1,sh), h=iHigh(s,PERIOD_H1,sh), l=iLow(s,PERIOD_H1,sh);
         double atr=H1ATRAt(s,sh+1); if(atr<=0) continue;
         if(MathAbs(c-o) < 2.0*atr) continue;
         int d=(c>o)?1:-1; MqlTick t; if(!SymbolInfoTick(s,t)) continue;
         double ep=(d>0)?t.ask:t.bid; double sl=(d>0)?l:h; double dist=d*(ep-sl);
         if(dist<=0.2*atr) continue;
         int k=ArraySize(syms); ArrayResize(syms,k+1); ArrayResize(dirs,k+1); ArrayResize(sls,k+1);
         syms[k]=s; dirs[k]=d; sls[k]=dist; cnt++;
      }
      for(int k=0;k<cnt;k++) Open(syms[k],dirs[k],sls[k],bal*RiskPct()/100.0/cnt,MAGIC_FOMC,"FOMC");
      if(InpVerbose) Print("FOMC判定: 条件を満たした銘柄 ",cnt);
   }
   CloseFOMCExpired();
   //--- ⑤ ストラドル：発表の10秒前に置く
   if(InpUseStraddle)
   {
      for(int e=0;e<ArraySize(g_ev);e++)
      {
         if(g_ev[e].placed) continue;
         long dt=(long)(g_ev[e].relUTC-utc);
         if(dt<=10 && dt>=0){ g_ev[e].placed=true; PlaceStraddle(e); }
         else if(dt<0 && dt>-60) g_ev[e].placed=true;   // 起動が遅れた場合は見送り
      }
      ManageStraddles();
      CloseStraddleExpired();
   }
   COTStep();
}
//+------------------------------------------------------------------+
